# Golden Boy reads these from the environment; nothing is required unless
# you use the corresponding adapter (see pyproject.toml optional-dependencies
# `anthropic` / `openai`). The core library, CLI (MockProvider), and the
# skills/goldenboy/SKILL.md workflow need neither.

# Required only by goldenboy.adapters.anthropic_adapter.AnthropicAdapter
ANTHROPIC_API_KEY=

# Required only by goldenboy.adapters.openai_adapter.OpenAIAdapter
OPENAI_API_KEY=

# Optional: override policy thresholds instead of editing .goldenboy/config.json.
# See goldenboy/core/config.py for the full list and defaults.
# GOLDENBOY_SAFETY_MARGIN=3.0
# GOLDENBOY_CAUTION_RATIO=0.5
# GOLDENBOY_BASE_COST_PER_UNIT=2.0
# GOLDENBOY_MAX_BUDGET_TOKENS=100000
